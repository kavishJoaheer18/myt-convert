# Production environment. Copy to .env on the server and fill in.
#   cp .env.prod.example .env && nano .env
#
# This file is read by docker-compose.prod.yml. Keep the real .env off git —
# .gitignore already excludes it.

# --- Database ---------------------------------------------------------------
# No defaults on purpose: the stack refuses to start rather than run on a
# guessable password. Generate one with: openssl rand -base64 32
POSTGRES_USER=mytconvert
POSTGRES_PASSWORD=
POSTGRES_DB=mytconvert

# --- Images -----------------------------------------------------------------
# Owner of the GHCR packages, and which tag to run. Pin to a sha- tag to hold a
# known-good build; 'latest' follows main.
IMAGE_OWNER=kavishjoaheer18
IMAGE_TAG=latest

# --- Networking -------------------------------------------------------------
# The only published port. Put a reverse proxy or Cloudflare tunnel in front of
# it; do not expose this directly to the internet without TLS.
PUBLIC_PORT=3000

# --- Worker ------------------------------------------------------------------
# OCR saturates whatever it is given. Leave a core or two for everything else.
WORKER_CPUS=2.0
WORKER_MEMORY=4g
# "mobile" (default) or "server". Server models are roughly ten times slower on
# CPU for a small accuracy gain.
OCR_MODEL_VARIANT=mobile

# --- Consensus ---------------------------------------------------------------
# Without a key the conversion still runs; it simply gets no second opinion and
# never routes work to the review screen.
ENABLE_CONSENSUS=true
VLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

LOG_LEVEL=INFO
