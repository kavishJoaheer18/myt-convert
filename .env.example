# Copy to .env and adjust. Every value here is the default the code already uses.

LOG_LEVEL=INFO
DATA_DIR=./data

DATABASE_URL=postgresql+psycopg://gridlock:gridlock@postgres:5432/gridlock
REDIS_URL=redis://redis:6379/0

# Pages with fewer extractable characters than this are routed to OCR.
MIN_CHARS_FOR_DIGITAL=20
# Raster resolution for OCR and for verification renders.
RENDER_DPI=300

# --- VLM (Phase 4 consensus) ---
# "anthropic" (default) or "ollama" for a local model.
VLM_PROVIDER=anthropic
VLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision
